# BROKER desk
PORT=8080
PREMIUM_RATE_BPS=500

# Choose one facilitator mode.
# Local:
X402_FACILITATOR_PRIVATE_KEY=
INJECTIVE_EVM_RPC_URL=https://k8s.testnet.json-rpc.injective.network/

# Remote (leave blank when using local mode):
X402_FACILITATOR_URL=
X402_PAY_TO=

# MCP / Solana reads
BROKER_URL=http://127.0.0.1:8080
SURETY_RPC_ENDPOINT=https://api.devnet.solana.com
BROKER_DEFAULT_VAULT=

# Funded bind orchestration is OFF unless explicitly enabled. It spends testnet
# assets and still requires a currently fresh TxLINE fixture.
BROKER_ENABLE_FUNDED_BIND=no
BROKER_BIND_JOBS_DIR=data/bind-jobs
BROKER_CCTP_INJECTIVE_KEY=
BROKER_SOLANA_KEYPAIR=
BROKER_BIND_VAULT=
BROKER_ODDS_WAIT_MINUTES=0
